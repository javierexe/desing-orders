# Example environment variables for backend (do NOT commit real secrets)
# Copy this file to backend/.env and fill values when developing locally.

# Database URL (replace with your actual database URL)
DATABASE_URL=postgresql://usuario:password@host:puerto/database?sslmode=require

## Supabase Storage configuration (if using Supabase)
# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co
# Service role key (keep secret, used by backend to manage storage)
SUPABASE_SERVICE_KEY=your_service_role_key_here
# Bucket name where receipts will be stored
SUPABASE_BUCKET=receipts

# Other environment variables
# SECRET_KEY=your_secret_key_here
# DEBUG=True